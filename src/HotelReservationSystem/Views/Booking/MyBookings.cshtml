@model List<HotelReservationSystem.Models.Booking>
@{
    ViewData["Title"] = "My Bookings";
}

<h2>My Bookings</h2>

@if (Model.Count == 0)
{
    <p>You have no bookings yet.</p>
    <p><a href="/Search">Search for rooms</a></p>
}
else
{
    <table border="1" cellpadding="8">
        <tr>
            <th>Booking ID</th>
            <th>Check-in</th>
            <th>Check-out</th>
            <th>Nights</th>
            <th>Total Paid</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
        @foreach (var b in Model)
        {
            int nights = (b.CheckOut - b.CheckIn).Days;
            <tr>
                <td>#@b.Id</td>
                <td>@b.CheckIn.ToString("dd MMM yyyy")</td>
                <td>@b.CheckOut.ToString("dd MMM yyyy")</td>
                <td>@nights</td>
                <td>@b.FinalPrice.ToString("C")</td>
                <td>@b.Status</td>
                <td>
                    @if (b.Status == "Confirmed")
                    {
                        <a href="/Booking/Success/@b.Id">View</a>
                    }
                </td>
            </tr>
        }
    </table>
}