@{
    ViewData["Title"] = "Admin Dashboard";
    var totalRevenue = ViewBag.TotalRevenue != null ? (decimal)ViewBag.TotalRevenue : 0m;
    var recentBookings = ViewBag.RecentBookings as List<HotelReservationSystem.Models.Booking>;
}

<h2>Administrator Dashboard</h2>
<p>Welcome to the revenue management console.</p>

<div style="display: flex; gap: 20px; margin-top: 20px;">
    <!-- Revenue Card Displayed -->
    <div style="border: 2px solid #1B2A4A; padding: 20px; border-radius: 8px; width: 250px; text-align: center;">
        <h4 style="margin: 0; color: #666;">Total Revenue</h4>
        <h1 style="margin: 10px 0; color: green;">@totalRevenue.ToString("C")</h1>
        <a href="/Admin/ExportRevenue" style="background-color: #1B2A4A; color: white; padding: 8px 15px; text-decoration: none; border-radius: 4px; font-size: 0.9em;">Export to CSV</a>
    </div>

    <!-- Pricing Card Displayed -->
    <div style="border: 2px solid #C9A24D; padding: 20px; border-radius: 8px; width: 250px; text-align: center;">
        <h4 style="margin: 0; color: #666;">Pricing Algorithm</h4>
        <p style="margin: 10px 0; font-size: 1.1em;">Understand how prices are calculated.</p>
        <a href="/Admin/PricingBreakdown" style="background-color: #C9A24D; color: white; padding: 8px 15px; text-decoration: none; border-radius: 4px; font-size: 0.9em;">View Breakdown</a>
    </div>
</div>

<hr style="margin: 30px 0;" />

<h3>Recent Bookings</h3>
@if (recentBookings == null || recentBookings.Count == 0)
{
    <p>No bookings yet.</p>
}
else
{
    <table border="1" cellpadding="8">
        <tr>
            <th>Booking ID</th>
            <th>Date Created</th>
            <th>Check-in</th>
            <th>Status</th>
            <th>Total Paid</th>
        </tr>
        @foreach (var b in recentBookings)
        {
            <tr>
                <td>#@b.Id</td>
                <td>@b.CreatedAt.ToString("dd MMM yyyy")</td>
                <td>@b.CheckIn.ToString("dd MMM yyyy")</td>
                <td>@b.Status</td>
                <td>@b.FinalPrice.ToString("C")</td>
            </tr>
        }
    </table>
}
